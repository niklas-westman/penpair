{
  "name": "penpair-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check": "pnpm check:style && pnpm build && pnpm typecheck && pnpm conventions:check && pnpm test && node scripts/check-versions.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "bump": "node scripts/bump.mjs",
    "release": "node scripts/release.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "docs:generate": "pnpm --filter @penpair/core build && node scripts/generate-troubleshooting.mjs && node scripts/generate-skill-index.mjs",
    "changeset": "changeset",
    "version-packages": "node scripts/version-packages.mjs",
    "smoke:browser": "pnpm build && node scripts/smoke-browser.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check:style": "biome check . && node scripts/check-code-paths.mjs",
    "conventions:check": "tsc -p docs/conventions/tsconfig.json && vitest run --config docs/conventions/vitest.config.ts",
    "sandbox:generate": "node scripts/generate-layout-source.mjs",
    "sandbox:check": "node scripts/generate-layout-source.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.12.0",
    "sharp": "0.35.5",
    "typescript": "5.6.3",
    "vitest": "3.2.4",
    "yaml": "2.9.1",
    "esbuild": "0.28.2"
  }
}

{
  "name": "@penpair/web",
  "version": "0.3.4",
  "description": "The penpair command for Penpot on the web (design.penpot.app or your team's own): guided setup, a safe write protocol, skills for AI agents. Includes everything in @penpair/core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niklas-westman/penpair.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/niklas-westman/penpair#readme",
  "bugs": {
    "url": "https://github.com/niklas-westman/penpair/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "penpair": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "penpot",
    "design-systems",
    "mcp",
    "ai-agents",
    "design-tokens",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build && node ../../scripts/copy-package-docs.mjs web",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@penpair/core": "workspace:*"
  }
}

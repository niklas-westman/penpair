{
  "name": "@penpair/core",
  "version": "0.3.7",
  "description": "Design together. Build together. The library and engine behind penpair: connect AI agents and people to a Penpot design file, safely. Install @penpair/web or @penpair/docker for the command.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niklas-westman/penpair.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/niklas-westman/penpair#readme",
  "bugs": {
    "url": "https://github.com/niklas-westman/penpair/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "penpot",
    "design-systems",
    "mcp",
    "ai-agents",
    "design-tokens",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "acorn": "8.19.0",
    "yaml": "2.9.1"
  }
}
